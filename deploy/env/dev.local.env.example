# Template of deploy/env/dev.local.env, the values of your machine for the dev environment. See
# docs/project/deployment.md. Copy it to dev.local.env next to this file and uncomment the lines you need;
# dev.local.env is not stored in Git. Values from dev.local.env override deploy/env/dev.env, and shell variables
# override both. Every line is commented out, so a copied template changes nothing.

# Required with --node: an absolute directory path as seen by the Docker daemon, without commas or whitespace.
# The node of this project works in its subdirectory testsys-dev, which deploy/testsys.sh creates; the directory
# itself must exist.
# Linux: a path of the host.
#TESTSYS_GRADING_NODE_WORKSPACE=/var/lib/testsys/grading-node
# Docker Desktop on Windows: C:\<path> is written as /run/desktop/mnt/host/c/<path>.
#TESTSYS_GRADING_NODE_WORKSPACE=/run/desktop/mnt/host/c/<path>

# Optional SQL script applied once per database after the migrations. It is a path on the machine that runs
# docker compose; a relative path is resolved from deploy/.
#TESTSYS_DB_SEED_SCRIPT=/absolute/path/to/seed.sql

# Ports of the host, if those of dev.env are busy.
#TESTSYS_HTTP_PORT=18080
#TESTSYS_MAIL_UI_PORT=18025
#TESTSYS_DB_PORT=15433

# Grading node addresses of the application, if you run dev without --node: nodes on other machines,
# comma-separated, or an empty value for no nodes.
#TESTSYS_GRADING_NODES=<host>:<port>
#TESTSYS_GRADING_NODES=

# A fixed host port of the gRPC node instead of a random one.
#TESTSYS_GRADING_NODE_PORT=50051
