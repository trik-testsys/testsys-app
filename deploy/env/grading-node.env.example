# Template of the variable file of a separate grading node (project testsys-grading-node). See
# docs/project/deployment.md. Copy it to a directory outside the Git checkout on the machine of the node and
# fill it in. Pass its path to deploy/testsys.sh:
#   sh deploy/testsys.sh node up --env-file <path>
# or set TESTSYS_ENV_FILE=<path>; the option takes precedence. Shell variables override values from the file.
# Required variables are left empty, so an unedited copy stops every command with the name of the variable.

# Required: a testsystrik/grading-node release tag.
TESTSYS_GRADING_NODE_TAG=
# Required: an absolute directory path on this machine as seen by the Docker daemon, without commas or whitespace.
# The node works in its subdirectory testsys-grading-node, which deploy/testsys.sh creates; the directory itself
# must exist.
TESTSYS_GRADING_NODE_WORKSPACE=

# gRPC has no TLS or authentication: publish it only on a private interface of this machine and allow
# connections only from the application server. An empty address means 127.0.0.1, unreachable from other machines.
TESTSYS_GRADING_NODE_HOST_IP=
# A fixed host port; the application gets <address of this machine>:<port> in TESTSYS_GRADING_NODES.
TESTSYS_GRADING_NODE_PORT=50051

TESTSYS_GRADING_NODE_RESTART=unless-stopped
# Unique for every grading node.
TESTSYS_GRADING_NODE_ID=1
TESTSYS_GRADING_NODE_WORKERS_COUNT=8
TESTSYS_GRADING_NODE_INNER_TIMEOUT_SECONDS=300
