<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-25-1" author="testsys">
        <createTable tableName="ts_announcement">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_announcement" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="shown_from" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="shown_until" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="ts_announcement" indexName="ix_ts_announcement_closed_at_shown_until_shown_from">
            <column name="closed_at"/>
            <column name="shown_until"/>
            <column name="shown_from"/>
        </createIndex>
    </changeSet>

    <changeSet id="1.0.0-25-init-announcement-checks" author="testsys">
        <sql><![CDATA[
            ALTER TABLE ts_announcement ADD CONSTRAINT ck_ts_announcement_kind CHECK (kind IN ('INFO', 'WARNING'));
            ALTER TABLE ts_announcement ADD CONSTRAINT ck_ts_announcement_period CHECK (shown_until > shown_from);
        ]]></sql>
        <rollback>
            <sql>
                ALTER TABLE ts_announcement DROP CONSTRAINT ck_ts_announcement_period;
                ALTER TABLE ts_announcement DROP CONSTRAINT ck_ts_announcement_kind;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
