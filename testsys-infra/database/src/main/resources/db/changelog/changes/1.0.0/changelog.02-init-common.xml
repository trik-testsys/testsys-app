<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-02-1" author="roman.shishkin">
        <createTable tableName="ts_file_data">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_file_data" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_file_name" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="stored_file_name" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="version_bucket" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="content_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-02-2" author="roman.shishkin">
        <createTable tableName="ts_trik_studio_version">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_trik_studio_version" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="tag" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_ts_trik_studio_version_tag"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
