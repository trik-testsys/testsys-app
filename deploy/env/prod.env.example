# Template of the variable file of the production environment (project testsys-prod). See
# docs/project/deployment.md. Copy it to a directory outside the Git checkout, restrict access to it
# (chmod 600) and fill it in; keep the copy in the backup. Pass its path to deploy/testsys.sh:
#   sh deploy/testsys.sh prod up --env-file <path>
# or set TESTSYS_ENV_FILE=<path>; the option takes precedence. Shell variables override values from the file.
# Required variables are left empty, so an unedited copy stops every command with the name of the variable.

# Required: password of the PostgreSQL user testsys.
TESTSYS_DB_PASSWORD=
# Required: password of the SMTP server; the other mail settings are in the configuration file below.
TESTSYS_MAIL_PASSWORD=
# Required: access code of the Supervisor, four groups of four Latin letters or digits separated by "-",
# for example aB3d-x9Yz-0kLm-P7qR. Changing it and restarting the application replaces the Supervisor access code;
# the previous code stops working.
TESTSYS_SUPERVISOR_ACCESS_TOKEN=
# Required: sign-in code of the service interface, at least 64 random characters, for example the output of
# "openssl rand -hex 32". Changing it and restarting the application replaces the code; the previous code stops
# working.
TESTSYS_SERVICE_SECRET=
# Required: address of the Grafana of this project in the browser of the administrator, opened from the service
# cabinet. Grafana is reached through an SSH tunnel; the local port of the tunnel must match the port of this
# address, for example http://localhost:3000/grafana/. The path of the address is the prefix of Grafana.
TESTSYS_GRAFANA_URL=
# Required: password of the Grafana administrator admin, for example the output of "openssl rand -hex 16".
# Grafana applies it only at the first start with an empty grafana-data volume; later change it in Grafana.
TESTSYS_GRAFANA_ADMIN_PASSWORD=
# Required: absolute path of the server copy of deploy/config/application-prod.example.yml.
TESTSYS_APP_CONFIG=

# Optional: comma-separated grading node addresses <host>:<port> offered for import in the service cabinet;
# grading-node:8080 with --node. Grading nodes are managed in the service cabinet.
#TESTSYS_GRADING_NODES=
# Optional: true adds the addresses of TESTSYS_GRADING_NODES to the node registry as enabled at every start.
#TESTSYS_GRADING_IMPORT_NODES=false

# Optional: port on 127.0.0.1 for the HTTPS proxy.
#TESTSYS_HTTP_PORT=8080
# Optional: port of the service interface on 127.0.0.1, reached directly, for example through an SSH tunnel.
#TESTSYS_SERVICE_HTTP_PORT=8081
# Optional: port of the metrics server on 127.0.0.1.
#TESTSYS_METRICS_HTTP_PORT=8082
# Optional: ports of Grafana and Prometheus on 127.0.0.1, reached through an SSH tunnel.
#TESTSYS_GRAFANA_PORT=3000
#TESTSYS_PROMETHEUS_PORT=9090
# Optional: name of the application image; "up" builds it from the checkout unless --no-build is given.
#TESTSYS_APP_IMAGE=testsys-app:latest

### Grading node on the same server, started with --node

# Required with --node: a testsystrik/grading-node release tag.
TESTSYS_GRADING_NODE_TAG=
# Required with --node: an absolute directory path on the server, without commas or whitespace. The node works
# in its subdirectory testsys-prod, which deploy/testsys.sh creates; the directory itself must exist.
TESTSYS_GRADING_NODE_WORKSPACE=
TESTSYS_GRADING_NODE_RESTART=unless-stopped
# Unique for every grading node.
TESTSYS_GRADING_NODE_ID=0
TESTSYS_GRADING_NODE_WORKERS_COUNT=8
TESTSYS_GRADING_NODE_INNER_TIMEOUT_SECONDS=300
# The application reaches this node by its service name; the published port stays on 127.0.0.1,
# and an empty port selects a random port of the host.
#TESTSYS_GRADING_NODE_HOST_IP=127.0.0.1
#TESTSYS_GRADING_NODE_PORT=
