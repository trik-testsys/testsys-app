# Variables of the dev environment (project testsys-dev), stored in Git. See docs/project/deployment.md.
# deploy/testsys.sh reads this file, then deploy/env/dev.local.env if it exists; a value from the local file
# overrides this file, and a shell variable overrides both. Put values of your machine into dev.local.env
# (template: dev.local.env.example) instead of editing this file.

# Ports of the main and service interfaces, the metrics server, the Mailpit web UI, PostgreSQL, Grafana and
# Prometheus on 127.0.0.1 of the Docker host.
TESTSYS_HTTP_PORT=8080
TESTSYS_SERVICE_HTTP_PORT=8083
TESTSYS_METRICS_HTTP_PORT=8082
TESTSYS_MAIL_UI_PORT=8025
TESTSYS_DB_PORT=5433
TESTSYS_GRAFANA_PORT=3000
TESTSYS_PROMETHEUS_PORT=9090

# Address of the Grafana of this project, opened from the service cabinet; its port matches TESTSYS_GRAFANA_PORT,
# its path is the prefix of Grafana.
TESTSYS_GRAFANA_URL=http://localhost:3000/grafana/

# Grading node addresses of the application: the node of this project started with --node.
TESTSYS_GRADING_NODES=grading-node:8080
# The grading node registry is stored in the database; every start adds these addresses to it as enabled.
TESTSYS_GRADING_IMPORT_NODES=true

# Secrets of the application, fixed and not secret in dev and e2e: the password of the PostgreSQL user testsys,
# the Supervisor access code, the sign-in code of the service interface and the key of access-code hashing.
TESTSYS_DB_PASSWORD=testsys
TESTSYS_SUPERVISOR_ACCESS_TOKEN=Supe-rvis-or00-0001
TESTSYS_SERVICE_SECRET=local-service-secret-for-dev-and-e2e-environments-only-not-secret
TESTSYS_ACCESS_TOKEN_SECRET=local-access-token-secret-for-dev-and-e2e-environments-only-not-secret
# Mailpit accepts mail without authorization.
TESTSYS_MAIL_PASSWORD=

# Grading node started with --node. TESTSYS_GRADING_NODE_WORKSPACE is set in dev.local.env.
TESTSYS_GRADING_NODE_TAG=3.0.0
TESTSYS_GRADING_NODE_WORKERS_COUNT=8
TESTSYS_GRADING_NODE_INNER_TIMEOUT_SECONDS=300
TESTSYS_GRADING_NODE_ID=0
# An empty port selects a random port of the host, shown by "sh deploy/testsys.sh dev ps --node".
TESTSYS_GRADING_NODE_HOST_IP=127.0.0.1
TESTSYS_GRADING_NODE_PORT=
TESTSYS_GRADING_NODE_RESTART=no
