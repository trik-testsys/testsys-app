{
  "uid": "testsys-failures",
  "title": "TestSys — ошибки операций и технические сбои",
  "description": "Ошибки операций, технические сбои и повторы транзакций TestSys. Коды HTTP-ответов, ошибки операций и технические сбои — разные срезы одних событий; эти показатели не складываются.",
  "tags": ["testsys"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m"] },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "smoothing",
        "label": "Сглаживание",
        "type": "custom",
        "query": "Авто : $__rate_interval, 1 мин : 1m, 5 мин : 5m, 10 мин : 10m, 30 мин : 30m",
        "multi": false,
        "includeAll": false,
        "current": { "selected": true, "text": "Авто", "value": "$__rate_interval" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Ошибки операций",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ошибки операций за период",
      "description": "Ожидаемые отказы операций Пользователей за выбранный период. Первое событие учитывается после успешного опроса, если нулевая точка создания ряда входит в период. До события показывается 0.",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "round(sum(increase(testsys_operation_errors_total{job=\"testsys\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ошибки операций в минуту по родам",
      "description": "Ошибки операций в минуту по общему роду ошибки: not_found, access_denied, missing_role, resource_access, other. Первое событие даёт прирост, пока нулевая точка создания ряда входит в окно расчёта.",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "opm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "60 * sum by (kind) (rate(testsys_operation_errors_total{job=\"testsys\"}[${smoothing:raw}]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Ошибки операций за период",
      "description": "Ошибки операций за выбранный период по операции, роду и классу ошибки. Счётчики округлены: прирост оценивается по замерам, включая нулевую точку создания ряда, если она входит в период.",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Ошибок", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "round(sum by (operation, kind, error) (increase(testsys_operation_errors_total{job=\"testsys\"}[$__range]))) > 0",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "operation": 0, "kind": 1, "error": 2, "Value": 3 },
            "renameByName": { "operation": "Операция", "kind": "Род", "error": "Ошибка", "Value": "Ошибок" }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Технические сбои",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Технические сбои за период",
      "description": "Непредвиденные исключения и обработанные отказы инфраструктуры за выбранный период. Первое событие учитывается после успешного опроса, если нулевая точка создания ряда входит в период. До события показывается 0.",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "round(sum(increase(testsys_technical_failures_total{job=\"testsys\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Технические сбои в минуту по источникам и этапам",
      "description": "Технические сбои в минуту по источнику и этапу. Первое событие даёт прирост, пока нулевая точка создания ряда входит в окно расчёта.",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "opm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "60 * sum by (source, stage) (rate(testsys_technical_failures_total{job=\"testsys\"}[${smoothing:raw}]))",
          "legendFormat": "{{source}}/{{stage}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Технические сбои за период",
      "description": "Технические сбои за выбранный период по источнику, этапу и классу исключения. Счётчики округлены: прирост оценивается по замерам, включая нулевую точку создания ряда, если она входит в период.",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Сбоев", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "round(sum by (source, stage, exception) (increase(testsys_technical_failures_total{job=\"testsys\"}[$__range]))) > 0",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "source": 0, "stage": 1, "exception": 2, "Value": 3 },
            "renameByName": { "source": "Источник", "stage": "Этап", "exception": "Исключение", "Value": "Сбоев" }
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Повторы транзакций",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Повторы транзакций за период",
      "description": "Повторы транзакций после конфликта с параллельной транзакцией. Первое событие учитывается после успешного опроса, если нулевая точка создания ряда входит в период. Повтор не считается ни ошибкой операции, ни техническим сбоем.",
      "gridPos": { "h": 7, "w": 4, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "round(sum(increase(testsys_transaction_retries_total{job=\"testsys\"}[$__range]))) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Повторы транзакций в минуту",
      "description": "Повторы транзакций в минуту. Первое событие даёт прирост, пока нулевая точка создания ряда входит в окно расчёта. Повтор не считается ни ошибкой операции, ни техническим сбоем.",
      "gridPos": { "h": 7, "w": 20, "x": 4, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
      "fieldConfig": { "defaults": { "unit": "opm", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testsys-prometheus" },
          "expr": "60 * sum(rate(testsys_transaction_retries_total{job=\"testsys\"}[${smoothing:raw}]))",
          "legendFormat": "Повторы"
        }
      ]
    }
  ]
}
