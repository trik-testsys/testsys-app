<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-07-1" author="roman.shishkin">
        <createTable tableName="ts_contest">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_contest" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_contest_owner" references="ts_user(id)"/>
            </column>
            <column name="starts_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="contest_duration_millis" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_duration_millis" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="trik_studio_version_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_contest_trik_studio_version" references="ts_trik_studio_version(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-07-2" author="roman.shishkin">
        <createTable tableName="ts_task_to_contest">
            <column name="task_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_task_to_contest" nullable="false"
                             foreignKeyName="fk_task_to_contest_task" references="ts_task(id)"/>
            </column>
            <column name="contest_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_task_to_contest" nullable="false"
                             foreignKeyName="fk_task_to_contest_contest" references="ts_contest(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-07-3" author="roman.shishkin">
        <createTable tableName="ts_community_to_contest">
            <column name="community_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_community_to_contest" nullable="false"
                             foreignKeyName="fk_community_to_contest_community" references="ts_community(id)"/>
            </column>
            <column name="contest_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_community_to_contest" nullable="false"
                             foreignKeyName="fk_community_to_contest_contest" references="ts_contest(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-07-4" author="roman.shishkin">
        <createTable tableName="ts_contest_to_class">
            <column name="contest_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_contest_to_class" nullable="false"
                             foreignKeyName="fk_contest_to_class_contest" references="ts_contest(id)"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_contest_to_class" nullable="false"
                             foreignKeyName="fk_contest_to_class_class" references="ts_class(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-07-5" author="roman.shishkin">
        <createTable tableName="ts_contest_to_competition">
            <column name="contest_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_contest_to_competition" nullable="false"
                             foreignKeyName="fk_contest_to_competition_contest" references="ts_contest(id)"/>
            </column>
            <column name="competition_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_contest_to_competition" nullable="false"
                             foreignKeyName="fk_contest_to_competition_competition" references="ts_competition(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
