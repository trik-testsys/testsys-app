<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-22-1" author="testsys">
        <createTable tableName="ts_regrade">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_regrade" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_regrade_task" references="ts_task(id)"/>
            </column>
        </createTable>

        <createIndex tableName="ts_regrade" indexName="ix_ts_regrade_task_id_created_at_id">
            <column name="task_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="1.0.0-22-2" author="testsys">
        <createTable tableName="ts_test_to_regrade">
            <column name="regrade_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_test_to_regrade" nullable="false"
                             foreignKeyName="fk_test_to_regrade_regrade" references="ts_regrade(id)"/>
            </column>
            <column name="test_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_test_to_regrade" nullable="false"
                             foreignKeyName="fk_test_to_regrade_test" references="ts_test(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-22-3" author="testsys">
        <createTable tableName="ts_submission_to_regrade">
            <column name="regrade_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_submission_to_regrade" nullable="false"
                             foreignKeyName="fk_submission_to_regrade_regrade" references="ts_regrade(id)"/>
            </column>
            <column name="submission_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_submission_to_regrade" nullable="false"
                             foreignKeyName="fk_submission_to_regrade_submission" references="ts_submission(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
