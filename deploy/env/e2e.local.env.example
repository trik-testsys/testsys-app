# Template of deploy/env/e2e.local.env, the values of your machine for the e2e environment. See
# docs/project/deployment.md. Copy it to e2e.local.env next to this file and uncomment the lines you need;
# e2e.local.env is not stored in Git. Values from e2e.local.env override deploy/env/e2e.env, and shell variables
# override both. Every line is commented out, so a copied template changes nothing.

# Required with --node: an absolute directory path as seen by the Docker daemon, without commas or whitespace.
# The node of this project works in its subdirectory testsys-e2e, which deploy/testsys.sh creates; the directory
# itself must exist.
# Linux: a path of the host.
#TESTSYS_GRADING_NODE_WORKSPACE=/var/lib/testsys/grading-node
# Docker Desktop on Windows: C:\<path> is written as /run/desktop/mnt/host/c/<path>.
#TESTSYS_GRADING_NODE_WORKSPACE=/run/desktop/mnt/host/c/<path>

# Ports of the host, if those of e2e.env are busy.
#TESTSYS_HTTP_PORT=18090
#TESTSYS_SERVICE_HTTP_PORT=18093
#TESTSYS_METRICS_HTTP_PORT=18092
#TESTSYS_MAIL_UI_PORT=18026
#TESTSYS_DB_PORT=15434

# Address opened by the Grafana button of the service cabinet; e2e runs no Grafana.
#TESTSYS_GRAFANA_URL=http://localhost:<port>/

# Grading node addresses of the application, if you run e2e without --node: nodes on other machines,
# comma-separated, or an empty value for no nodes.
#TESTSYS_GRADING_NODES=<host>:<port>
#TESTSYS_GRADING_NODES=

# A fixed host port of the gRPC node instead of a random one.
#TESTSYS_GRADING_NODE_PORT=50052
