# Variables of the e2e environment (project testsys-e2e), stored in Git. See docs/project/deployment.md.
# deploy/testsys.sh reads this file, then deploy/env/e2e.local.env if it exists; a value from the local file
# overrides this file, and a shell variable overrides both. Put values of your machine into e2e.local.env
# (template: e2e.local.env.example) instead of editing this file.

# Ports of the main and service interfaces, the metrics server, the Mailpit web UI and PostgreSQL on 127.0.0.1
# of the Docker host.
TESTSYS_HTTP_PORT=8090
TESTSYS_SERVICE_HTTP_PORT=8093
TESTSYS_METRICS_HTTP_PORT=8092
TESTSYS_MAIL_UI_PORT=8026
TESTSYS_DB_PORT=5434

# Address opened by the Grafana button of the service cabinet; required by the application, though e2e runs
# no Prometheus and Grafana.
TESTSYS_GRAFANA_URL=http://localhost:3000/grafana/

# Grading node addresses of the application: the node of this project started with --node.
TESTSYS_GRADING_NODES=grading-node:8080

# Grading node started with --node. TESTSYS_GRADING_NODE_WORKSPACE is set in e2e.local.env.
TESTSYS_GRADING_NODE_TAG=3.0.0
TESTSYS_GRADING_NODE_WORKERS_COUNT=8
TESTSYS_GRADING_NODE_INNER_TIMEOUT_SECONDS=300
TESTSYS_GRADING_NODE_ID=0
# An empty port selects a random port of the host, shown by "sh deploy/testsys.sh e2e ps --node".
TESTSYS_GRADING_NODE_HOST_IP=127.0.0.1
TESTSYS_GRADING_NODE_PORT=
TESTSYS_GRADING_NODE_RESTART=no
