<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-03-1" author="roman.shishkin">
        <comment>User: discriminated by type into MULTIPLE_ROLE and SINGLE_ROLE users.</comment>

        <createTable tableName="ts_user">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_user" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="access_token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_ts_user_access_token"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uk_ts_user_email"/>
            </column>
            <column name="type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-03-3" author="roman.shishkin">
        <comment>SingleRoleToUser: pairing (role, user) for single-role users (composite PK).</comment>

        <createTable tableName="ts_single_role_to_user">
            <column name="single_role" type="VARCHAR(64)">
                <constraints primaryKey="true" primaryKeyName="pk_ts_single_role_to_user" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             primaryKey="true" primaryKeyName="pk_ts_single_role_to_user"
                             foreignKeyName="fk_single_role_to_user_user" references="ts_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

