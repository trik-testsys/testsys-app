<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-23-1" author="testsys">
        <createTable tableName="ts_cabinet_sign_in">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_cabinet_sign_in" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_ts_cabinet_sign_in_token_hash"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="user_kind" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="impersonated_by" type="BIGINT"/>
            <column name="last_seen_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="ts_cabinet_sign_in" baseColumnNames="user_id"
                                 referencedTableName="ts_user" referencedColumnNames="id"
                                 constraintName="fk_ts_cabinet_sign_in_user_id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="ts_cabinet_sign_in" baseColumnNames="impersonated_by"
                                 referencedTableName="ts_user" referencedColumnNames="id"
                                 constraintName="fk_ts_cabinet_sign_in_impersonated_by" onDelete="CASCADE"/>
        <createIndex tableName="ts_cabinet_sign_in" indexName="ix_ts_cabinet_sign_in_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="ts_cabinet_sign_in" indexName="ix_ts_cabinet_sign_in_impersonated_by">
            <column name="impersonated_by"/>
        </createIndex>
        <createIndex tableName="ts_cabinet_sign_in" indexName="ix_ts_cabinet_sign_in_last_seen_at">
            <column name="last_seen_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="1.0.0-23-init-cabinet-sign-in-checks" author="testsys">
        <sql><![CDATA[
            ALTER TABLE ts_cabinet_sign_in ADD CONSTRAINT ck_ts_cabinet_sign_in_user_kind CHECK (
                user_kind IN ('MULTIPLE_ROLE', 'PARTICIPANT', 'OBSERVER', 'SUPERVISOR', 'SERVICE')
            );
            ALTER TABLE ts_cabinet_sign_in ADD CONSTRAINT ck_ts_cabinet_sign_in_service_user CHECK (
                (user_id IS NULL) = (user_kind = 'SERVICE')
            );
            ALTER TABLE ts_cabinet_sign_in ADD CONSTRAINT ck_ts_cabinet_sign_in_impersonated_user CHECK (
                impersonated_by IS NULL OR user_id IS NOT NULL
            );
        ]]></sql>
        <rollback>
            <sql>
                ALTER TABLE ts_cabinet_sign_in DROP CONSTRAINT ck_ts_cabinet_sign_in_impersonated_user;
                ALTER TABLE ts_cabinet_sign_in DROP CONSTRAINT ck_ts_cabinet_sign_in_service_user;
                ALTER TABLE ts_cabinet_sign_in DROP CONSTRAINT ck_ts_cabinet_sign_in_user_kind;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
