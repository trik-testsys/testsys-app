<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-09-1" author="roman.shishkin">
        <comment>JudgmentOrder: a judge's manual override of a verdict, with a textual reason.</comment>

        <createTable tableName="ts_judgment_order">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_judgment_order" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="judge_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_judgment_order_judge" references="ts_user(id)"/>
            </column>
            <column name="verdict_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_judgment_order_verdict" references="ts_verdict(id)"/>
            </column>
            <column name="reason" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
