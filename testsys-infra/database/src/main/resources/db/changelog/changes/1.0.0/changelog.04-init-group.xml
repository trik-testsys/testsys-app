<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1.0.0-04-1" author="roman.shishkin">
        <createTable tableName="ts_class">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_class" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_class_owner" references="ts_user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-2" author="roman.shishkin">
        <createTable tableName="ts_community">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_community" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_community_owner" references="ts_user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-3" author="roman.shishkin">
        <createTable tableName="ts_competition">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_competition" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_competition_owner" references="ts_user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-4" author="roman.shishkin">
        <createTable tableName="ts_student_to_class">
            <column name="student_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_student_to_class" nullable="false"
                             foreignKeyName="fk_student_to_class_user" references="ts_user(id)"/>
            </column>
            <column name="class_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_student_to_class" nullable="false"
                             foreignKeyName="fk_student_to_class_class" references="ts_class(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-6" author="roman.shishkin">
        <createTable tableName="ts_competition_to_observer">
            <column name="competition_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_competition_to_observer" nullable="false"
                             foreignKeyName="fk_competition_to_observer_competition" references="ts_competition(id)"/>
            </column>
            <column name="observer_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_competition_to_observer" nullable="false"
                             foreignKeyName="fk_competition_to_observer_user" references="ts_user(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-7" author="roman.shishkin">
        <addForeignKeyConstraint constraintName="fk_participant_data_competition"
                                 baseTableName="ts_participant_data" baseColumnNames="competition_id"
                                 referencedTableName="ts_competition" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="1.0.0-04-8" author="roman.shishkin">
        <comment>ObserverData.community_id FK to Community (deferred until ts_community exists).</comment>

        <addForeignKeyConstraint constraintName="fk_observer_data_community"
                                 baseTableName="ts_observer_data" baseColumnNames="community_id"
                                 referencedTableName="ts_community" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="1.0.0-04-9" author="roman.shishkin">
        <createTable tableName="ts_multiple_role_to_user">
            <column name="multiple_role" type="VARCHAR(64)">
                <constraints primaryKey="true" primaryKeyName="pk_ts_multiple_role_to_user" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_multiple_role_to_user" nullable="false"
                             foreignKeyName="fk_multiple_role_to_user_user" references="ts_user(id)"/>
            </column>
            <column name="community_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_ts_multiple_role_to_user" nullable="false"
                             foreignKeyName="fk_multiple_role_to_user_community" references="ts_community(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.0-04-10" author="roman.shishkin">
        <comment>Competition.participants is projected from ParticipantData.competition_id.</comment>
        <createIndex indexName="ix_ts_participant_data_competition_id" tableName="ts_participant_data">
            <column name="competition_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
